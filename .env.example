# Neon Postgres connection string (pooled). Copy from https://console.neon.tech
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Random secret used to sign sessions/cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""

# Base URL of this app (used for cookie/session origin checks).
# Must match the port `npm run dev` actually serves on.
BETTER_AUTH_URL="http://localhost:8080"

# Gemini API key (available but not routed to by default -- see AI Architecture
# in CLAUDE.md). Generate from https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# OpenRouter API key (text provider fallback). Generate from https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=""

# Groq API key (primary text provider). Generate from https://console.groq.com/keys
GROQ_API_KEY=""

# Cloudflare Workers AI (image provider). Free-plan usable: 10,000 Neurons/day,
# no credit card required. Account ID: right sidebar of any dashboard overview
# page. API token: My Profile -> API Tokens -> Create Token -> Workers AI template.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# A SEPARATE Cloudflare token, scoped for `wrangler deploy` (Workers Scripts
# edit, Account Settings read, User Details read -- template "Edit Cloudflare
# Workers"). Deliberately kept apart from CLOUDFLARE_API_TOKEN above so a
# leak/misuse of the deploy token can never touch the live image pipeline.
# Not read by the app itself -- exported as CLOUDFLARE_API_TOKEN in your shell
# only for the one `wrangler deploy`/`wrangler rollback` command, see
# docs/OPERATIONS.md.
CLOUDFLARE_DEPLOY_TOKEN=""

# Cloudinary (image storage -- Cloudflare Workers AI returns raw bytes, not a
# URL; also used for user file uploads and avatars). Free plan, no credit
# card required. All three values are on the Cloudinary dashboard/console
# home page.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (password resets, change-email confirmation, in-app feedback
# emails). Generate from https://resend.com/api-keys. Until a custom domain
# is verified in Resend, sends go from the shared onboarding@resend.dev
# address, which Resend restricts to only your own account's verified email.
RESEND_API_KEY=""

# Inbox that receives in-app feedback/bug-report submissions (see the
# feedback dialog in the app topbar). Must be an address Resend will
# actually deliver to -- see the RESEND_API_KEY note above. Falls back to a
# hardcoded address in src/lib/server/email.ts if unset; always set this.
SUPPORT_EMAIL=""

# Google OAuth ("Continue with Google"). Create a client at
# https://console.cloud.google.com/apis/credentials and whitelist this app's
# real callback URL (BETTER_AUTH_URL + "/api/auth/callback/google").
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Polar.sh (billing/subscriptions, Merchant of Record). Create an
# organization + an Organization Access Token at https://polar.sh, plus one
# product per paid plan (Pro, Scale) -- see CLAUDE.md's "Polar.sh Payment
# Integration" section for the full setup walkthrough.
POLAR_ACCESS_TOKEN=""
# "sandbox" for testing, "production" for real payments.
POLAR_SERVER="sandbox"
POLAR_PRO_PRODUCT_ID=""
POLAR_SCALE_PRODUCT_ID=""
# Only needed once you've registered a webhook endpoint in Polar's
# dashboard (Settings -> Webhooks) pointed at
# <BETTER_AUTH_URL>/api/auth/polar/webhooks -- omit entirely until then,
# the webhook handler is only mounted when this is set.
POLAR_WEBHOOK_SECRET=""

# Optional safety valves, both have sane defaults if left unset -- see
# src/lib/server/credits.ts. Tune these up as your own paid-tier AI/infra
# limits allow.
# Global cap on real AI image generations per UTC day, across all users
# combined (protects Cloudflare Workers AI's free-tier quota). Default: 1500.
DAILY_IMAGE_CAP=""
# Per-user daily credit-spend cap for the unlimited Scale plan, so one heavy
# user can't consume the whole shared DAILY_IMAGE_CAP alone. Default: 500.
SCALE_DAILY_CREDIT_CAP=""

# Canonical <link> tag origin for public/SEO pages (src/lib/canonical.ts).
# Leave unset in local dev / before a real domain exists -- when unset, no
# canonical tag is rendered at all (honest absence, not a broken relative
# link). Set to your real deployed domain once you have one, e.g.
# "https://your-worker.workers.dev".
SITE_URL=""
