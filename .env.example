# Neon Postgres connection string (pooled). Copy from https://console.neon.tech
# Project: creatoros-ai
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Random secret used to sign sessions/cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""

# Base URL of this app (used for cookie/session origin checks).
# Must match the port `npm run dev` actually serves on (this project's Vite default is 8080).
BETTER_AUTH_URL="http://localhost:8080"

# Gemini API key. Generate from https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# OpenRouter API key (text provider fallback). Generate from https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=""

# Groq API key (primary text provider). Generate from https://console.groq.com/keys
GROQ_API_KEY=""

# Cloudflare Workers AI (image provider). Free-plan usable: 10,000 Neurons/day,
# no credit card required. Account ID: right sidebar of any dashboard overview
# page. API token: My Profile -> API Tokens -> Create Token -> Workers AI template.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Cloudinary (image storage -- Cloudflare Workers AI returns raw bytes, not a
# URL). Free plan, no credit card required. All three values are on the
# Cloudinary dashboard/console home page.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (password-reset emails). Generate from https://resend.com/api-keys.
# Until a custom domain is verified in Resend, sends go from the shared
# onboarding@resend.dev address.
RESEND_API_KEY=""
